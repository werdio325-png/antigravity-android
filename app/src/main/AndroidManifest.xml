<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="dev.continuum.antigravity"
    android:versionCode="30"
    android:versionName="3.0.0">

    <!-- targetSdk 28 is REQUIRED: Android 10+ (W^X) only allows exec of a binary
         from the app data dir when the app targets API <= 28. The core + glibc
         loader live in files/runtime/bin and are exec'd directly. -->
    <uses-sdk android:minSdkVersion="24" android:targetSdkVersion="28" />

    <queries>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <category android:name="android.intent.category.BROWSABLE" />
            <data android:scheme="https" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <category android:name="android.intent.category.BROWSABLE" />
            <data android:scheme="http" />
        </intent>
        <intent>
            <action android:name="android.intent.action.GET_CONTENT" />
            <data android:mimeType="*/*" />
        </intent>
        <intent>
            <action android:name="android.intent.action.OPEN_DOCUMENT" />
            <data android:mimeType="*/*" />
        </intent>
        <!-- Package installer (in-app updater hands the verified APK to it). -->
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:mimeType="application/vnd.android.package-archive" />
        </intent>
    </queries>

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" />
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" />
    <uses-permission android:name="android.permission.MANAGE_EXTERNAL_STORAGE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.CAMERA" />
    <!-- The updater never installs silently: it always hands the verified APK
         to Android's package installer, which shows the system consent UI. -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <permission
        android:name="dev.continuum.antigravity.permission.INTERNAL_BROADCAST"
        android:protectionLevel="signature" />
    <uses-permission android:name="dev.continuum.antigravity.permission.INTERNAL_BROADCAST" />

    <application
        android:allowBackup="false"
        android:hardwareAccelerated="true"
        android:largeHeap="true"
        android:extractNativeLibs="true"
        android:usesCleartextTraffic="true"
        android:requestLegacyExternalStorage="true"
        android:networkSecurityConfig="@xml/network_security_config"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:theme="@style/AppTheme">

        <!--
          MainActivity is NOT the launcher: the LAUNCHER intent-filter lives on
          two REAL launcher activities (Duolingo-style dynamic icon). Only one
          is enabled at a time; ThemeManager.applyLauncherIcon() toggles them to
          match the persisted theme. LauncherDarkActivity is enabled by default
          so a fresh install has exactly one launcher entry. Real activities
          (not activity-alias) are required so the OS starting window reads the
          per-theme SplashTheme and the system splash background follows the
          in-app theme instead of the system day/night.
        -->
        <activity
            android:name="dev.continuum.antigravity.ui.MainActivity"
            android:exported="false"
            android:theme="@style/SplashTheme"
            android:launchMode="singleTask"
            android:configChanges="orientation|screenSize|keyboardHidden|smallestScreenSize|screenLayout|uiMode|density"
            android:windowSoftInputMode="adjustResize" />

        <!-- No deep-link intent-filter: the core's OAuth success URL is left
             untouched and the app never intercepts the browser handoff, so the
             original login flow runs unmodified. -->

        <activity
            android:name="dev.continuum.antigravity.ui.launcher.LauncherDarkActivity"
            android:enabled="true"
            android:exported="true"
            android:theme="@style/SplashThemeDark"
            android:icon="@mipmap/ic_launcher_dark"
            android:roundIcon="@mipmap/ic_launcher_dark_round"
            android:label="@string/app_name"
            android:launchMode="singleTask"
            android:configChanges="orientation|screenSize|keyboardHidden|smallestScreenSize|screenLayout|uiMode|density"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name="dev.continuum.antigravity.ui.launcher.LauncherLightActivity"
            android:enabled="false"
            android:exported="true"
            android:theme="@style/SplashThemeLight"
            android:icon="@mipmap/ic_launcher_light"
            android:roundIcon="@mipmap/ic_launcher_light_round"
            android:label="@string/app_name"
            android:launchMode="singleTask"
            android:configChanges="orientation|screenSize|keyboardHidden|smallestScreenSize|screenLayout|uiMode|density"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <receiver
            android:name="dev.continuum.antigravity.runtime.TorchReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="dev.continuum.antigravity.ACTION_TORCH" />
            </intent-filter>
        </receiver>

        <service
            android:name="dev.continuum.antigravity.core.CoreServerService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

        <provider
            android:name="dev.continuum.antigravity.util.AppFileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true" />
    </application>
</manifest>
