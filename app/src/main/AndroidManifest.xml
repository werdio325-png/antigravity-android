<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.agy"
    android:versionCode="3"
    android:versionName="2.1.0">

    <!-- targetSdk 28 is REQUIRED: Android 10+ (W^X) only allows exec of a binary
         from the app data dir when the app targets API <= 28. The core + glibc
         loader live in files/runtime/bin and are exec'd directly. -->
    <uses-sdk android:minSdkVersion="24" android:targetSdkVersion="28" />

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" />
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" />
    <uses-permission android:name="android.permission.MANAGE_EXTERNAL_STORAGE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!-- dev build: android:debuggable="true" enables `run-as com.agy`; revert for release -->
    <application
        android:debuggable="true"
        android:allowBackup="false"
        android:hardwareAccelerated="true"
        android:largeHeap="true"
        android:extractNativeLibs="true"
        android:usesCleartextTraffic="true"
        android:requestLegacyExternalStorage="true"
        android:networkSecurityConfig="@xml/network_security_config"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:theme="@style/AppTheme">

        <!--
          MainActivity is NOT the launcher: the LAUNCHER intent-filter lives on
          two REAL launcher activities (Duolingo-style dynamic icon). Only one
          is enabled at a time; ThemeManager.applyLauncherIcon() toggles them to
          match the persisted theme. LauncherDarkActivity is enabled by default
          so a fresh install has exactly one launcher entry. Real activities
          (not activity-alias) are required so the OS starting window reads the
          per-theme SplashTheme and the system splash background follows the
          in-app theme instead of the system day/night.
        -->
        <activity
            android:name="com.agy.ui.MainActivity"
            android:exported="true"
            android:theme="@style/SplashTheme"
            android:launchMode="singleTask"
            android:configChanges="orientation|screenSize|keyboardHidden|smallestScreenSize|screenLayout|uiMode|density"
            android:windowSoftInputMode="adjustResize" />

        <!-- No deep-link intent-filter: the core's OAuth success URL is left
             untouched and the app never intercepts the browser handoff, so the
             original login flow runs unmodified. -->

        <activity
            android:name="com.agy.ui.launcher.LauncherDarkActivity"
            android:enabled="true"
            android:exported="true"
            android:theme="@style/SplashThemeDark"
            android:icon="@mipmap/ic_launcher_dark"
            android:roundIcon="@mipmap/ic_launcher_dark_round"
            android:label="@string/app_name"
            android:launchMode="singleTask"
            android:configChanges="orientation|screenSize|keyboardHidden|smallestScreenSize|screenLayout|uiMode|density"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name="com.agy.ui.launcher.LauncherLightActivity"
            android:enabled="false"
            android:exported="true"
            android:theme="@style/SplashThemeLight"
            android:icon="@mipmap/ic_launcher_light"
            android:roundIcon="@mipmap/ic_launcher_light_round"
            android:label="@string/app_name"
            android:launchMode="singleTask"
            android:configChanges="orientation|screenSize|keyboardHidden|smallestScreenSize|screenLayout|uiMode|density"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <service
            android:name="com.agy.core.CoreServerService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />
    </application>
</manifest>
