<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
      API31+ Android 12 splash. Guarded in values-v31/ so minSdk 24 still
      compiles. windowBackground switches back to the solid color for the
      post-splash activity window (the animated icon covers the pre-content
      frame).
    -->
    <style name="SplashTheme" parent="@style/AppTheme">
        <item name="android:windowSplashScreenBackground">@color/window_background</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/splash_icon</item>
        <item name="android:windowSplashScreenIconBackgroundColor">@android:color/transparent</item>
        <item name="android:windowBackground">@color/window_background</item>
    </style>

    <!--
      API31+ system splash for the launcher aliases. The alias theme is the only
      theme the OS reads for the starting window, so these are what make the
      system splash follow the in-app theme instead of the system day/night.
      windowSplashScreenAnimatedIcon is the sized layer-list: visible logo ~2/3
      of the 288dp canvas (transparent icon background -> 192dp).
    -->
    <style name="SplashThemeDark" parent="@style/AppTheme">
        <item name="android:windowSplashScreenBackground">@color/splash_bg_dark</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/splash_icon</item>
        <item name="android:windowSplashScreenIconBackgroundColor">@android:color/transparent</item>
        <item name="android:windowBackground">@color/splash_bg_dark</item>
    </style>
    <style name="SplashThemeLight" parent="@style/AppTheme">
        <item name="android:windowSplashScreenBackground">@color/splash_bg_light</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/splash_icon</item>
        <item name="android:windowSplashScreenIconBackgroundColor">@android:color/transparent</item>
        <item name="android:windowBackground">@color/splash_bg_light</item>
    </style>
</resources>
