<?xml version="1.0" encoding="utf-8"?>
<!--
  Pre-API31 splash fallback (also the activity window background on API<31).
  Solid day/night color resolved via @color/window_background
  (#ffffff in values/, #101010 in values-night/) + centered transparent logo.
-->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:drawable="@color/window_background" />
    <item
        android:drawable="@drawable/splash_icon"
        android:gravity="center" />
</layer-list>
