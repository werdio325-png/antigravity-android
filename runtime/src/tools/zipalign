#!/system/bin/sh
if [ -z "$NATIVE_DIR" ] || [ ! -d "$NATIVE_DIR" ]; then
  for d in /data/app/*/com.antigravity.mobile*/lib/arm64 /data/app/~~*/com.antigravity.mobile*/lib/arm64 /data/data/com.antigravity.mobile.dev/lib /data/data/com.antigravity.mobile/lib; do
    if [ -d "$d" ]; then NATIVE_DIR="$d"; break; fi
  done
fi
exec "$NATIVE_DIR/libzipalign.so" "$@"
