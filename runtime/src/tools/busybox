#!/system/bin/sh
if [ -z "$NATIVE_DIR" ] || [ ! -d "$NATIVE_DIR" ]; then
  for d in /data/app/*/com.antigravity.mobile*/lib/arm64 /data/app/~~*/com.antigravity.mobile*/lib/arm64 /data/data/com.antigravity.mobile.dev/lib /data/data/com.antigravity.mobile/lib; do
    if [ -d "$d" ]; then NATIVE_DIR="$d"; break; fi
  done
fi
APPLET="${0##*/}"

if [ -f "$NATIVE_DIR/libbusybox.so" ]; then
  exec "$NATIVE_DIR/ld-linux-aarch64.so.1" --library-path "$NATIVE_DIR:/system/lib64" --argv0 "$APPLET" "$NATIVE_DIR/libbusybox.so" "$@"
else
  if [ "$APPLET" = "busybox" ]; then
    if [ -n "$1" ]; then exec /system/bin/toybox "$@"; else exec /system/bin/toybox; fi
  else
    exec /system/bin/toybox "$APPLET" "$@"
  fi
fi

