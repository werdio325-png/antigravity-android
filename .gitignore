# Output APKs and build products
output/
*.apk
*.idsig

# Staging and compilation artifacts
staging/
build/
**/build/
*.o
*.obj
*.class
*.dex
!runtime/src/tools/rish_shizuku.dex

# Extracted Web UI assets (regenerated via patches/patch_web.py)
web_ui/

# Large proprietary core binary (download or obtain separately, >100MB)
core/language_server
core/*.tar.gz
core/*.tar
core/*.so

# Python bytecode and caches
__pycache__/
*.py[cod]
*$py.class

# Sensitive credentials & tokens
*-oauth-token
*.token
*.key
.gitconfig

# OS and editor artifacts
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
*~
