# AGY v2 — external (vendor) inputs. Symlinks are unavailable on this FUSE
# mount, so heavy immutable inputs stay in place and are referenced by
# absolute path. Nothing here is copied into v2 except the light web assets.
#
# Sourced by build/lib/paths.sh with `set -a`.

AGY_HOME="${AGY_HOME:-$PROJECT}"

# Heavy runtime inputs (never modified, never copied into the tree)
CORE_BIN="${CORE_BIN:-$AGY_HOME/core/language_server}"
GLIBC_DIR="${GLIBC_DIR:-$AGY_HOME/core/glibc}"
CERTS_DIR="${CERTS_DIR:-$AGY_HOME/core/certs}"
SEED_DIR="${SEED_DIR:-$AGY_HOME/core/seed}"
TOOLS_SRC_DIR="${TOOLS_SRC_DIR:-$AGY_HOME/core/tools}"

# Bionic toolchain layer (project-local in v2)
ENV_DIR="${PROJECT:-$AGY_HOME}/env"
ENV_DIST="${ENV_DIST:-$PROJECT/env/dist/env}"

# Host toolchain jars
ANDROID_JAR="${ANDROID_JAR:-$AGY_HOME/tools/android.jar}"
R8_JAR="${R8_JAR:-$AGY_HOME/tools/r8.jar}"
KEYSTORE="${KEYSTORE:-$AGY_HOME/tools/debug.keystore}"
