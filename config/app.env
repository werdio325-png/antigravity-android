# Continuum for Android — single source of truth for app-level constants.
# Parsed by modules/builder/01_gen_config.py.
# Plain KEY=VALUE, no spaces around '='. Do not add shell logic here.
#
# This is an independent fork of Antigravity for Android (Apache 2.0).
# The application id deliberately differs from the upstream `com.agy`, so both
# the original app and this fork can be installed side by side and neither
# overwrites the other's data directory.

PKG=dev.continuum.antigravity
PKG_DEV=dev.continuum.antigravity.dev
APP_NAME=Continuum
APP_NAME_DEV=Continuum Dev

# Loopback ports. Upstream uses 45157/45158 (engine) and 45160/45161 (gateway);
# the fork uses a disjoint range so both apps can run at the same time.
PORT=45167
PORT_DEV=45168
GATEWAY_PORT=45170
GATEWAY_PORT_DEV=45171

# The core renders its own OAuth success page; no deep link is registered in the
# manifest, so this scheme is informational only.
OAUTH_SCHEME=antigravity

# App package version (must match the release tag v<APP_VERSION_NAME>).
APP_VERSION_NAME=3.0.0
APP_VERSION_CODE=30

# Upstream core/runtime version is separate from the Android app version.
# Do not change this to a version that is not actually embedded.
CORE_VERSION=2.11.0

MIN_API=24
TARGET_SDK=28

# In-app updater: GitHub Releases feed for this fork (owner/repo).
UPDATE_REPO=sahilsahilimtiyaz-code/antigravity-android-update
UPDATE_ASSET=continuum.apk
UPDATE_CHECKSUMS_ASSET=SHA256SUMS.txt
