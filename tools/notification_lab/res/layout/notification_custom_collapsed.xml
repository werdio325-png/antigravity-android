<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="64dp"
    android:background="#0D1117"
    android:gravity="center_vertical"
    android:paddingStart="12dp"
    android:paddingEnd="12dp"
    android:orientation="horizontal">

    <!-- Antigravity Icon -->
    <ImageView
        android:id="@+id/notif_icon"
        android:layout_width="38dp"
        android:layout_height="38dp"
        android:src="@drawable/ic_antigravity_logo"
        android:layout_marginEnd="12dp" />

    <!-- Text Block -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/notif_app_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="ANTIGRAVITY"
                android:textColor="#38BDF8"
                android:textSize="10sp"
                android:textStyle="bold"
                android:letterSpacing="0.08" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text=" • "
                android:textColor="#555E6D"
                android:textSize="10sp" />

            <TextView
                android:id="@+id/notif_tag"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="AGENT"
                android:textColor="#8B949E"
                android:textSize="10sp"
                android:textStyle="bold" />
        </LinearLayout>

        <TextView
            android:id="@+id/notif_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Заголовок уведомления"
            android:textColor="#FFFFFF"
            android:textSize="13sp"
            android:textStyle="bold"
            android:singleLine="true"
            android:ellipsize="end" />

        <TextView
            android:id="@+id/notif_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Краткое описание действия..."
            android:textColor="#8B949E"
            android:textSize="12sp"
            android:singleLine="true"
            android:ellipsize="end" />
    </LinearLayout>

    <!-- Status pill -->
    <TextView
        android:id="@+id/notif_status_pill"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="● READY"
        android:textColor="#10B981"
        android:textSize="9sp"
        android:textStyle="bold"
        android:background="@drawable/badge_online"
        android:paddingStart="8dp"
        android:paddingEnd="8dp"
        android:paddingTop="3dp"
        android:paddingBottom="3dp"
        android:layout_marginStart="8dp" />

</LinearLayout>
