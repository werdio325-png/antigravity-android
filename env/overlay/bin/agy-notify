#!/data/user/0/com.agy/files/usr/bin/bash
# agy-notify - Post and manage clickable, Antigravity-branded Android notifications.
set -e

SCRIPT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" 2>/dev/null && pwd)"
PREFIX="${PREFIX:-$(cd -- "$SCRIPT_DIR/.." 2>/dev/null && pwd)}"
RISH_BIN="$PREFIX/bin/rish"
SHARE_DIR="$PREFIX/share/agy-notify-dex"
DEX_SRC="$SHARE_DIR/agy_notify.jar"
ICON_SMALL_SRC="$SHARE_DIR/ic_notification.png"
ICON_LARGE_SRC="$SHARE_DIR/ic_launcher_round.png"
DEX_TMP="/data/local/tmp/agy_notify.jar"
ICON_SMALL_TMP="/data/local/tmp/agy_ic_notification.png"
ICON_LARGE_TMP="/data/local/tmp/agy_ic_launcher.png"

USAGE="Usage: agy-notify [post|cancel|list] [options]
Commands:
  post    -t <title> [-s <subtitle>] [-m <message>] [--tag <tag>]
  cancel  <tag>
  list    Show active notifications
"

CMD="${1:-post}"
shift || true

TITLE="Antigravity"
SUBTITLE=""
MESSAGE=""
TAG="agy_turn_done"

if [ "$CMD" = "cancel" ]; then
    if [ "$#" -ne 1 ] || [ -z "$1" ]; then
        echo "agy-notify: cancel requires exactly one tag" >&2
        echo "$USAGE" >&2
        exit 2
    fi
    TAG="$1"
    set --
fi

while [[ $# -gt 0 ]]; do
    case "$1" in
        -t|--title)
            [ "$#" -ge 2 ] || { echo "agy-notify: missing value for $1" >&2; exit 2; }
            TITLE="$2"
            shift 2
            ;;
        -s|--subtitle)
            [ "$#" -ge 2 ] || { echo "agy-notify: missing value for $1" >&2; exit 2; }
            SUBTITLE="$2"
            shift 2
            ;;
        -m|--message)
            [ "$#" -ge 2 ] || { echo "agy-notify: missing value for $1" >&2; exit 2; }
            MESSAGE="$2"
            shift 2
            ;;
        --tag)
            [ "$#" -ge 2 ] || { echo "agy-notify: missing value for $1" >&2; exit 2; }
            TAG="$2"
            shift 2
            ;;
        *)
            if [ -z "$MESSAGE" ]; then
                MESSAGE="$1"
            fi
            shift
            ;;
    esac
done

run_shell() {
    if adb devices 2>/dev/null | grep -q "device$"; then
        adb shell "$1" 2>/dev/null
    elif [ -x "$RISH_BIN" ]; then
        "$RISH_BIN" -c "$1" 2>/dev/null
    else
        return 1
    fi
}

sync_asset() {
    local src="$1"
    local dst="$2"
    [ -f "$src" ] || return 0
    local src_size dst_size
    src_size=$(wc -c < "$src" 2>/dev/null | tr -d ' ')
    dst_size=$(run_shell "wc -c < $dst 2>/dev/null || echo 0" | tr -d '\r ')
    if [ "$src_size" != "$dst_size" ]; then
        if adb devices 2>/dev/null | grep -q "device$"; then
            adb push "$src" "$dst" >/dev/null 2>&1 || true
        else
            run_shell "cp -f $(printf %q "$src") $dst && chmod 644 $dst" || true
        fi
    fi
}

if [ "$CMD" = "post" ]; then
    if [ -z "$MESSAGE" ] && [ -n "$TITLE" ]; then
        MESSAGE="$TITLE"
        TITLE="Antigravity"
    fi

    BODY_TEXT="$MESSAGE"
    if [ -n "$SUBTITLE" ]; then
        BODY_TEXT="[$SUBTITLE] $MESSAGE"
    fi

    if [ -f "$DEX_SRC" ]; then
        sync_asset "$DEX_SRC" "$DEX_TMP"
        sync_asset "$ICON_SMALL_SRC" "$ICON_SMALL_TMP"
        sync_asset "$ICON_LARGE_SRC" "$ICON_LARGE_TMP"
        if run_shell "CLASSPATH=$DEX_TMP /system/bin/app_process /system/bin AgyClickableNotify $(printf %q "$TITLE") $(printf %q "$BODY_TEXT") $(printf %q "$TAG")"; then
            exit 0
        fi
    fi

    run_shell "cmd notification post -S bigtext -t $(printf %q "$TITLE") $(printf %q "$TAG") $(printf %q "$BODY_TEXT")" && exit 0 || true
    echo "[agy-notify] notification queued: $TITLE - $MESSAGE"

elif [ "$CMD" = "cancel" ]; then
    run_shell "cmd notification cancel $(printf %q "$TAG")" || true

elif [ "$CMD" = "list" ]; then
    run_shell "dumpsys notification --noredact" | grep -E "pkg=|android.title=|android.text=" | head -n 40 || true

else
    echo "$USAGE"
    exit 1
fi
