#!/usr/bin/env python3
"""
agy-mcp-browser - Zero-dependency stdio MCP server exposing the standard
`chrome_devtools` tool surface backed by native Android WebView automation
(`WebBrowserAutomationHandler` via `SystemGatewayServer` `browser_auto`).

Protocol: JSON-RPC 2.0 over newline-delimited stdin/stdout (MCP 2024-11-05+).
"""

import os
import sys
import json
import time
import base64
import urllib.error
import urllib.request

SERVER_NAME = "chrome-devtools"
SERVER_VERSION = "1.0.0"
SUPPORTED_PROTOCOL_VERSIONS = ("2025-06-18", "2025-03-26", "2024-11-05")
DEFAULT_PROTOCOL_VERSION = "2024-11-05"
DEFAULT_GATEWAY_PORT = 45160
MAX_INLINE_SCREENSHOT_BYTES = 2 * 1024 * 1024

_PAGE_STATE = {
    "open": False,
    "url": "about:blank",
    "title": "",
}


def get_prefix():
    env_prefix = os.environ.get("PREFIX", "").strip()
    if env_prefix:
        return env_prefix
    return os.path.dirname(os.path.dirname(os.path.realpath(__file__)))


def get_home():
    env_home = os.environ.get("HOME", "").strip()
    if env_home:
        return env_home
    return os.path.dirname(get_prefix())


def get_gateway_port():
    env_port = os.environ.get("AGY_GATEWAY_PORT", "").strip()
    if env_port:
        try:
            p = int(env_port)
            if 1 <= p <= 65535:
                return p
        except ValueError:
            pass

    home = get_home()
    port_file = os.path.join(home, "logs", "gateway.port")
    try:
        if os.path.isfile(port_file):
            with open(port_file, "r", encoding="utf-8") as f:
                p = int(f.read().strip())
                if 1 <= p <= 65535:
                    return p
    except Exception:
        pass

    state_file = os.path.join(home, "logs", "core.state.json")
    try:
        if os.path.isfile(state_file):
            with open(state_file, "r", encoding="utf-8") as f:
                data = json.load(f)
            p = int(data.get("gateway_port", 0))
            if 1 <= p <= 65535:
                return p
    except Exception:
        pass

    return DEFAULT_GATEWAY_PORT


def gateway_browser(payload, timeout=35.0):
    port = get_gateway_port()
    url = f"http://127.0.0.1:{port}/gateway"
    body = json.dumps({
        "command": "browser_auto",
        "payload": payload,
    }, ensure_ascii=False).encode("utf-8")
    req = urllib.request.Request(
        url,
        data=body,
        headers={"Content-Type": "application/json; charset=utf-8"},
        method="POST",
    )
    try:
        with urllib.request.urlopen(req, timeout=timeout) as resp:
            raw = resp.read().decode("utf-8", errors="replace").strip()
            return json.loads(raw) if raw else {"ok": True}
    except urllib.error.HTTPError as e:
        detail = ""
        try:
            detail = e.read().decode("utf-8", errors="replace").strip()[:300]
        except Exception:
            pass
        return {"ok": False, "error": f"Gateway HTTP {e.code}: {detail or e.reason}"}
    except urllib.error.URLError as e:
        return {"ok": False, "error": f"Gateway unreachable at 127.0.0.1:{port}: {e.reason}"}
    except Exception as e:
        return {"ok": False, "error": f"Gateway request failed: {e}"}


def _css_escape_attr_value(val):
    return str(val).replace("\\", "\\\\").replace('"', '\\"')


def _resolve_selector(args):
    uid = str(args.get("uid") or "").strip()
    selector = str(args.get("selector") or "").strip()
    if uid:
        return f'[data-agy-uid="{_css_escape_attr_value(uid)}"]'
    return selector


