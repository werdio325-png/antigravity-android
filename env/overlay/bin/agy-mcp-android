# -----------------------------------------------------------------------------
# Tool Handlers
# -----------------------------------------------------------------------------
def handle_device_info(_args):
    return gateway_post("system_info", {})


def handle_notify(args):
    payload = {}
    action = str(args.get("action") or "post")
    payload["action"] = action
    for key in (
        "type", "approval", "title", "message", "tag", "id", "channel",
        "progress", "max", "indeterminate", "ongoing", "reply_label",
        "cascade_id", "interaction_id", "subagent_id", "callback_url",
    ):
        if key in args and args[key] is not None:
            payload[key] = args[key]

    actions = args.get("actions")
    request_id = args.get("request_id")
    needs_request_id = (
        actions is not None
        or bool(args.get("approval"))
        or args.get("type") == "tool_approval"
    )
    if actions is not None:
        payload["actions"] = actions
    if needs_request_id and not request_id:
        request_id = f"req_{uuid.uuid4().hex[:12]}"
    if request_id:
        payload["request_id"] = str(request_id)

    resp = gateway_post("notify", payload)
    if request_id and isinstance(resp, dict) and "request_id" not in resp:
        resp["request_id"] = str(request_id)
    return resp


def handle_wait_approval(args):
    request_id = str(args.get("request_id") or "").strip()
    if not request_id:
        return {"ok": False, "error": "request_id is required"}

    timeout_sec = float(args.get("timeout_sec", 60))
    timeout_sec = max(1.0, min(timeout_sec, 300.0))
    poll_interval_ms = int(args.get("poll_interval_ms", 1000))
    poll_interval_ms = max(200, min(poll_interval_ms, 5000))

    deadline = time.monotonic() + timeout_sec
    encoded_id = urllib.parse.quote(request_id, safe="")

    while True:
        remaining_ms = int(max(0.0, (deadline - time.monotonic()) * 1000.0))
        wait_ms = min(poll_interval_ms, remaining_ms) if remaining_ms > 0 else 0

        resp = gateway_post(
            "approval_poll",
            {"id": request_id, "wait_ms": wait_ms},
            timeout=max(10.0, (wait_ms / 1000.0) + 5.0),
        )
        if not resp.get("ok") and "unknown command" in str(resp.get("error", "")).lower():
            resp = gateway_get(f"/gateway/approval?id={encoded_id}&wait_ms={wait_ms}", timeout=max(10.0, (wait_ms / 1000.0) + 5.0))

        if not resp.get("ok"):
            return resp

        status = str(resp.get("status", "pending")).lower()
        decision = resp.get("decision")
        if status == "decided" or (decision is not None and str(decision) != ""):
            out = {
                "ok": True,
                "id": request_id,
                "status": "decided",
                "decision": decision,
                "comment": resp.get("comment"),
                "decided_at": resp.get("decided_at"),
            }
            for extra_key in ("cascade_id", "interaction_id", "subagent_id"):
                if resp.get(extra_key) is not None:
                    out[extra_key] = resp[extra_key]
            return out

        remaining = deadline - time.monotonic()
        if remaining <= 0:
            return {
                "ok": True,
                "id": request_id,
                "status": "timeout",
                "decision": None,
                "comment": None,
            }
        time.sleep(min(poll_interval_ms / 1000.0, remaining))


def handle_subagent_notify(args):
    payload = {}
    action = str(args.get("action") or "post")
    payload["action"] = action
    for key in (
        "subagent_id", "cascade_id", "role", "title", "message",
        "progress", "max", "indeterminate", "ongoing", "cancellable",
        "request_id", "callback_url", "tag", "id",
    ):
        if key in args and args[key] is not None:
            payload[key] = args[key]
    return gateway_post("subagent_notify", payload)


def handle_voice_service(args):
    action = str(args.get("action") or "").strip()
    if not action:
        return {"ok": False, "error": "action is required"}
    payload = {"action": action}
    for key in ("status_text", "speakerphone"):
        if key in args and args[key] is not None:
            payload[key] = args[key]
    resp = gateway_post("voice_service", payload)
    if action == "status" and not resp.get("ok") and "unknown command" in str(resp.get("error", "")).lower():
        return gateway_get("/gateway/voice/status")
    return resp


def handle_clipboard_get(_args):
    return gateway_post("clipboard", {"action": "get"})


def handle_clipboard_set(args):
    text = args.get("text")
    if text is None:
        return {"ok": False, "error": "text is required"}
    return gateway_post("clipboard", {"action": "set", "text": str(text)})


def handle_toast(args):
    message = args.get("message")
    if message is None:
        return {"ok": False, "error": "message is required"}
    duration = str(args.get("duration") or "short")
    return gateway_post("toast", {"message": str(message), "duration": duration})


def handle_vibrate(args):
    duration_ms = int(args.get("duration_ms", 100))
    duration_ms = max(10, min(duration_ms, 5000))
    return gateway_post("vibrate", {"duration_ms": duration_ms})


def handle_torch(args):
    if "enabled" not in args:
        return {"ok": False, "error": "enabled boolean is required"}
    enabled = bool(args["enabled"])
    resp = gateway_post("torch", {"enabled": enabled})
    if resp.get("ok"):
        return resp
    # Fallback for older gateway builds without direct torch command
    if "unknown command" in str(resp.get("error", "")).lower():
        rish_bin = _find_rish_bin()
        state = "true" if enabled else "false"
        try:
            proc = subprocess.run(
                [rish_bin, "-c", f"am broadcast -a com.agy.ACTION_TORCH --ez enabled {state}"],
                capture_output=True,
                text=True,
                timeout=10,
            )
            return {
                "ok": proc.returncode == 0,
                "enabled": enabled,
                "via": "broadcast_fallback",
                "stdout": (proc.stdout or "").strip(),
                "stderr": (proc.stderr or "").strip(),
            }
        except Exception as e:
            return {"ok": False, "error": f"torch fallback failed: {e}"}
    return resp


def handle_shizuku_exec(args):
    command = str(args.get("command") or "").strip()
    if not command:
        return {"ok": False, "error": "command is required"}
    timeout_sec = int(args.get("timeout_sec", 30))
    timeout_sec = max(1, min(timeout_sec, 300))
    rish_bin = _find_rish_bin()
    try:
        proc = subprocess.run(
            [rish_bin, "-c", command],
            capture_output=True,
            text=True,
            timeout=timeout_sec,
        )
        stdout = _truncate_text(proc.stdout or "")
        stderr = _truncate_text(proc.stderr or "")
        result = {
            "ok": proc.returncode == 0,
            "exit_code": proc.returncode,
            "stdout": stdout,
            "stderr": stderr,
        }
        if proc.returncode != 0 and "server is not running" in (stderr + stdout).lower():
            result["hint"] = "Shizuku service is not running on the device. Ask the user to start Shizuku."
        return result
    except FileNotFoundError:
        return {"ok": False, "error": f"rish binary not found at {rish_bin}"}
    except subprocess.TimeoutExpired:
        return {"ok": False, "error": f"Shizuku command timed out after {timeout_sec}s"}
    except Exception as e:
        return {"ok": False, "error": f"Shizuku exec failed: {e}"}


def handle_browser_automate(args):
    action = str(args.get("action") or "").strip()
    if not action:
        return {"ok": False, "error": "action is required"}

    payload = {"action": action}
    for key in ("url", "script", "selector", "text", "clear", "max_chars", "path", "timeout_ms", "width", "height"):
        if key in args and args[key] is not None:
            payload[key] = args[key]

    timeout_ms = args.get("timeout_ms")
    http_timeout = 35.0
    if timeout_ms is not None:
        try:
            http_timeout = max(35.0, (float(timeout_ms) / 1000.0) + 10.0)
        except (TypeError, ValueError):
            pass

    return gateway_post("browser_auto", payload, timeout=http_timeout)


def _run_daemon_cli(cli_args, timeout_sec=20):
    daemon_bin = _find_daemon_bin()
    cmd = [sys.executable, daemon_bin] + cli_args if os.path.isfile(daemon_bin) else [daemon_bin] + cli_args
    env = os.environ.copy()
    env["PREFIX"] = get_prefix()
    env["HOME"] = get_home()
    try:
        proc = subprocess.run(
            cmd,
            capture_output=True,
            text=True,
            timeout=timeout_sec,
            env=env,
        )
        stdout = (proc.stdout or "").strip()
        stderr = (proc.stderr or "").strip()
        parsed = None
        if stdout:
            try:
                parsed = json.loads(stdout)
            except json.JSONDecodeError:
                parsed = None
        if proc.returncode != 0:
            return {
                "ok": False,
                "exit_code": proc.returncode,
                "error": (parsed.get("error") if isinstance(parsed, dict) and "error" in parsed else None)
                or stderr
                or stdout
                or f"agy-daemon exited with {proc.returncode}",
                "output": parsed if parsed is not None else stdout,
            }
        if parsed is not None:
            if isinstance(parsed, dict):
                result = dict(parsed)
                result.setdefault("ok", result.get("status") != "error")
                return result
            return {"ok": True, "tasks": parsed}
        return {"ok": True, "output": stdout}
    except FileNotFoundError:
        return {"ok": False, "error": f"agy-daemon binary not found at {daemon_bin}"}
    except subprocess.TimeoutExpired:
        return {"ok": False, "error": f"agy-daemon timed out after {timeout_sec}s"}
    except Exception as e:
        return {"ok": False, "error": f"agy-daemon invocation failed: {e}"}


def handle_schedule_task(args):
    action = str(args.get("action") or "").strip()
    if action == "status":
        return _run_daemon_cli(["status"])

    if action == "list":
        cli_args = ["task", "list", "--json"]
        if args.get("active_only"):
            cli_args.append("--active-only")
        return _run_daemon_cli(cli_args)

    if action in ("pause", "resume", "remove", "run_now"):
        task_id = str(args.get("id") or "").strip()
        if not task_id:
            return {"ok": False, "error": f"id is required for action '{action}'"}
        subcmd = "run-now" if action == "run_now" else action
        return _run_daemon_cli(["task", subcmd, task_id, "--json"])

    if action == "add":
        cli_args = ["task", "add", "--json"]
        flag_map = (
            ("name", "--name"),
            ("prompt", "--prompt"),
            ("command", "--command"),
            ("project", "--project"),
            ("conversation_id", "--conversation-id"),
            ("delay", "--delay"),
            ("interval", "--interval"),
            ("cron", "--cron"),
            ("watch_file", "--watch-file"),
            ("github_pr", "--github-pr"),
            ("github_issue", "--github-issue"),
            ("battery_below", "--battery-below"),
        )
        for key, flag in flag_map:
            val = args.get(key)
            if val is not None and str(val) != "":
                cli_args.extend([flag, str(val)])
        if args.get("wake_app"):
            cli_args.append("--wake-app")
        return _run_daemon_cli(cli_args)

    return {"ok": False, "error": f"unsupported action: {action}"}


TOOL_HANDLERS = {
    "android_device_info": handle_device_info,
    "android_notify": handle_notify,
    "android_wait_approval": handle_wait_approval,
    "android_subagent_notify": handle_subagent_notify,
    "android_voice_service": handle_voice_service,
    "android_clipboard_get": handle_clipboard_get,
    "android_clipboard_set": handle_clipboard_set,
    "android_toast": handle_toast,
    "android_vibrate": handle_vibrate,
    "android_torch": handle_torch,
    "android_shizuku_exec": handle_shizuku_exec,
    "android_browser_automate": handle_browser_automate,
    "android_schedule_task": handle_schedule_task,
}


# -----------------------------------------------------------------------------
# JSON-RPC 2.0 / MCP Protocol Dispatcher
# -----------------------------------------------------------------------------
def _rpc_result(req_id, result):
    return {"jsonrpc": "2.0", "id": req_id, "result": result}


def _rpc_error(req_id, code, message, data=None):
    err = {"code": code, "message": message}
    if data is not None:
        err["data"] = data
    return {"jsonrpc": "2.0", "id": req_id, "error": err}


def handle_message(msg):
    if not isinstance(msg, dict):
        return _rpc_error(None, -32600, "Invalid Request")

    method = msg.get("method")
    req_id = msg.get("id")
    params = msg.get("params") or {}
    is_notification = ("id" not in msg) or (isinstance(method, str) and method.startswith("notifications/"))

    if not isinstance(method, str) or not method:
        return None if is_notification else _rpc_error(req_id, -32600, "Missing method")

    if method == "notifications/initialized" or method.startswith("notifications/"):
        return None

    if method == "initialize":
        requested = params.get("protocolVersion") if isinstance(params, dict) else None
        version = requested if requested in SUPPORTED_PROTOCOL_VERSIONS else DEFAULT_PROTOCOL_VERSION
        return _rpc_result(req_id, {
            "protocolVersion": version,
            "capabilities": {
                "tools": {"listChanged": False},
            },
            "serverInfo": {
                "name": SERVER_NAME,
                "version": SERVER_VERSION,
            },
        })

    if method == "ping":
        return _rpc_result(req_id, {})

    if method == "tools/list":
        return _rpc_result(req_id, {"tools": TOOLS})

    if method == "tools/call":
        if not isinstance(params, dict):
            return _rpc_error(req_id, -32602, "Invalid params: object expected")
        tool_name = params.get("name")
        arguments = params.get("arguments")
        if arguments is None:
            arguments = {}
        if not isinstance(arguments, dict):
            return _rpc_error(req_id, -32602, "Invalid tool arguments: object expected")

        handler = TOOL_HANDLERS.get(tool_name)
        if handler is None:
            return _rpc_error(req_id, -32602, f"Unknown tool: {tool_name}")

        try:
            result = handler(arguments)
            is_error = isinstance(result, dict) and (result.get("ok") is False)
            text = json.dumps(result, ensure_ascii=False, indent=2)
            return _rpc_result(req_id, {
                "content": [{"type": "text", "text": text}],
                "isError": is_error,
            })
        except Exception as e:
            return _rpc_result(req_id, {
                "content": [{"type": "text", "text": json.dumps({"ok": False, "error": str(e)})}],
                "isError": True,
            })

    if is_notification:
        return None
    return _rpc_error(req_id, -32601, f"Method not found: {method}")


def serve_stdio(stdin=None, stdout=None):
    in_stream = stdin if stdin is not None else sys.stdin
    out_stream = stdout if stdout is not None else sys.stdout

    while True:
        line = in_stream.readline()
        if not line:
            break
        stripped = line.strip()
        if not stripped:
            continue

        try:
            msg = json.loads(stripped)
        except json.JSONDecodeError as e:
            resp = _rpc_error(None, -32700, f"Parse error: {e}")
            out_stream.write(json.dumps(resp, ensure_ascii=False) + "\n")
            out_stream.flush()
            continue

        resp = handle_message(msg)
        if resp is not None:
            out_stream.write(json.dumps(resp, ensure_ascii=False) + "\n")
            out_stream.flush()


def main():
    if len(sys.argv) > 1 and sys.argv[1] in ("--version", "-v"):
        print(f"{SERVER_NAME} {SERVER_VERSION}")
        return 0
    if len(sys.argv) > 1 and sys.argv[1] in ("--help", "-h"):
        print("agy-mcp-android: MCP stdio server for native Android device tools.")
        print("Run with no arguments to serve JSON-RPC 2.0 over stdin/stdout.")
        return 0

    try:
        serve_stdio()
    except KeyboardInterrupt:
        pass
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
